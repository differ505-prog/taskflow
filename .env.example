# ─── Supabase (必要) ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── AI 任務粉碎機 (AI Task Shredder) ───
# 從 Google AI Studio 取得: https://aistudio.google.com/apikey
# 用途: /api/shred 呼叫 Gemini 1.5 Flash 拆解任務
# 注意: 這是 server-side key,絕對不要加 NEXT_PUBLIC_ 前綴
GEMINI_API_KEY=your-gemini-api-key

# ─── Vercel Cron (僅 production 需要) ───
# /api/email/cs 需 SUPABASE_SERVICE_ROLE_KEY + RESEND_API_KEY
# 本機開發若不需要 cron 功能可不設
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# RESEND_API_KEY=your-resend-key
# RESEND_FROM_EMAIL=noreply@yourdomain.com
# RESEND_FROM_NAME=VibeList
# CRON_SECRET=your-cron-secret

# ─── Web Push (VAPID) ───────────────────────────────
# 產生: npx web-push generate-vapid-keys
# 公鑰 (NEXT_PUBLIC_ 前綴 = 前端可讀): pushManager.subscribe() 需要
# 私鑰 (server-side only): 後端推播時簽名用，絕對不要加 NEXT_PUBLIC_
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key
# ⚠️ 公鑰改了 = 所有裝置訂閱失效，必須重新訂閱一次

# ─── Sentry (錯誤監測 + Performance) ────────────────
# 從 https://sentry.io → Settings → Projects → Client Keys (DSN) 取得
# NEXT_PUBLIC_ 前綴 = 前端可讀,但實際只在 client config 用
NEXT_PUBLIC_SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id
# SENTRY_DSN=your-server-dsn (可與 NEXT_PUBLIC_SENTRY_DSN 同值,server config fallback)
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=taskflow
# SENTRY_AUTH_TOKEN=your-auth-token (僅 CI 用,source map upload)
# 不設 DSN = Sentry disabled,build 不會失敗
